ON e.dept_id = d.dept_id;


Q 2   SELECT p.proj_id, p.proj_name, d.dept_name, p.budget
FROM projects p
INNER JOIN departments d
ON p.dept_id = d.dept_id;



Q 3 SELECT e.emp_name, d.dept_name, p.proj_name
